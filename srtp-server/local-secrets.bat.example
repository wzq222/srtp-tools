@echo off
rem ============================================================
rem  local-secrets.bat.example
rem
rem  复制本文件为 local-secrets.bat（同一目录），填入本机真实值。
rem  local-secrets.bat 已被 .gitignore 忽略，不会被提交到仓库。
rem
rem  服务器上不需要这个文件 —— 服务器端由 GitHub Actions
rem  从 Repository Secrets 下发到 C:\srtp\shared\.env。
rem ============================================================

rem ---- 数据库 ----
set "DB_URL=jdbc:mysql://127.0.0.1:3306/srtp_tsp?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=UTF-8"
set "DB_USERNAME=root"
set "DB_PASSWORD=在此填写你的 MySQL 密码"

rem ---- Python 解释器（需自带 numpy）----
set "PYTHON_EXECUTABLE=C:\Users\你的用户名\AppData\Local\Programs\Python\Python312\python.exe"
set "PYTHON_SCRIPT_DIR=python"

rem ---- 外部服务 API Key（可选）----
set "APP_API_KEY="

rem ---- 服务端口（可选）----
set "SERVER_PORT=8090"
